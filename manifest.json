{
  "manifest_version": 3,
  "name": "Hourglass",
  "version": "0.2.0",
  "description": "Manual billable-time tracker for freelance design work. All data stays on your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hourglass",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Open Hourglass"
    }
  },
  "permissions": ["storage", "alarms"]
}
